{
  "openapi": "3.1.0",
  "info": {
    "title": "coverage",
    "version": "1.0.0"
  },
  "security": [],
  "paths": {
    "/things/{thingId}": {
      "get": {
        "operationId": "getThing",
        "parameters": [
          {
            "name": "thingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                }
              }
            }
          }
        }
      }
    },
    "/things/batch": {
      "post": {
        "operationId": "createThings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ThingInput"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ThingResult"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/things/loose": {
      "post": {
        "operationId": "createLooseThings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ThingInput"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Thing": {
        "type": "object",
        "required": [
          "id",
          "colour",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "colour": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "ThingView": {
        "type": "object",
        "required": [
          "id",
          "colour",
          "hue"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "colour": {
            "type": "string"
          },
          "hue": {
            "type": "string"
          }
        }
      },
      "ThingInput": {
        "type": "object",
        "required": [
          "colour"
        ],
        "properties": {
          "colour": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        }
      },
      "ThingResult": {
        "type": "object",
        "properties": {
          "value": {
            "$ref": "#/components/schemas/Thing"
          },
          "problem": {
            "$ref": "#/components/schemas/Problem"
          }
        }
      }
    }
  }
}
